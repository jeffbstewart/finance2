# Template for .env — copy to .env and fill in real values.
# .env is git-ignored AND .aiignore'd: never committed, never read by AI.
# This template is the documentation of every variable and lives in git.

# Port the finance2 server listens on (gRPC + gRPC-Web + SPA), reached
# only via HAProxy (see TRUSTED_PROXIES).
PORT=9090

# LAN-only ops port: serves exactly /healthz and /metrics (Prometheus
# exposition), plus / redirecting to /metrics. Reachable directly —
# no proxy, no auth — and nothing else answers on it.
INTERNAL_PORT=9091

# H2 database location and credentials (required — the server opens
# its database at startup). DB_PATH is the database file path without
# extension; the file is AES-encrypted at rest with H2_FILE_PASSWORD;
# H2_PASSWORD is the SA user password.
DB_PATH=./data/finance2
H2_PASSWORD=change-me
H2_FILE_PASSWORD=change-me-too

# Session cookies are marked Secure by default (the browser-facing
# origin is HTTPS via HAProxy — build-scope §10). Set false only for a
# plain-HTTP local dev setup, or the browser will drop the cookie.
COOKIE_SECURE=true

# Comma-separated IPs of the HAProxy instance(s) allowed to talk to
# this server (build-scope §10). When set, requests from any other
# peer are rejected (except /healthz and /metrics), and proxied
# requests missing X-Forwarded-For fail as bad requests. Leave unset
# only for direct-connection local development.
TRUSTED_PROXIES=127.0.0.1

# Note: first-run setup needs no variable here — when the server boots
# with no user, it prints a one-time setup token to its log, which
# CreateFirstUser requires.

# Decision 4 market-data providers (Tiingo primary, EODHD fallback).
# Each is optional: a provider is used only when its key is present;
# with neither, MARKET-locus securities simply have no prices. Free
# tiers of both suffice (decisions/4-price-providers.md).
TIINGO_API_KEY=
EODHD_API_KEY=

# Directory where bankferry drops InvestmentsSnapshot proto files for
# import (Phase 4; see docs/design/plaid-investments-pipeline.md).
# finance2 never talks to Plaid and holds no Plaid credentials.
PLAID_SNAPSHOT_DIR=./data/snapshots
