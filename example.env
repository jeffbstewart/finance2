# Template for .env - copy to .env and fill in real values.
# .env is git-ignored AND .aiignore'd: never committed, never read by AI.
# This template is the documentation of every variable and lives in git.

# Port the finance2 server listens on (gRPC + gRPC-Web + SPA), reached
# only via HAProxy (see TRUSTED_PROXIES).
PORT=9090

# LAN-only ops port: serves exactly /healthz and /metrics (Prometheus
# exposition), plus / redirecting to /metrics. Reachable directly - 
# no proxy, no auth - and nothing else answers on it.
INTERNAL_PORT=9091

# H2 database location and credentials (required - the server opens
# its database at startup). DB_PATH is the database file path without
# extension; the file is AES-encrypted at rest with H2_FILE_PASSWORD;
# H2_PASSWORD is the SA user password.
DB_PATH=./data/finance2
H2_PASSWORD=change-me
H2_FILE_PASSWORD=change-me-too

# Session cookies are marked Secure by default (the browser-facing
# origin is HTTPS via HAProxy - build-scope sec. 10). Set false only for a
# plain-HTTP local dev setup, or the browser will drop the cookie.
COOKIE_SECURE=true

# Comma-separated addresses of the HAProxy instance(s) allowed to talk
# to this server (build-scope sec. 10): single IPs or CIDR ranges
# (172.28.0.0/24, fd00::/8). When set, requests from any other peer
# are rejected (except /healthz and /metrics), and proxied requests
# missing X-Forwarded-For fail as bad requests. Leave unset only for
# direct-connection local development.
#
# Under compose, a proxy on the same host arrives from the gateway of
# the stack's network, which docker-compose.yml pins to FINANCE2_SUBNET
# (172.28.0.0/24 -> gateway 172.28.0.1). Use the gateway, or the whole
# subnet if you would rather not depend on it.
TRUSTED_PROXIES=127.0.0.1

# The stack's own network under compose (see docker-compose.yml).
# Change only if 172.28.0.0/24 collides with something on your host.
#FINANCE2_SUBNET=172.28.0.0/24

# Note: first-run setup needs no variable here - when the server boots
# with no user, it prints a one-time setup token to its log, which
# CreateFirstUser requires.

# Decision 4 market-data providers (Tiingo primary, EODHD fallback).
# Each is optional: a provider is used only when its key is present;
# with neither, MARKET-locus securities simply have no prices. Free
# tiers of both suffice (decisions/4-price-providers.md).
TIINGO_API_KEY=
EODHD_API_KEY=

# bankferry snapshots arrive by upload through the UI (the Imports
# page) - there is no drop directory. finance2 never talks to Plaid and
# holds no Plaid credentials.
#
# Docker (docker-compose.yml): the compose file names every variable
# it forwards into the container and takes them from the environment -
# Portainer stack variables, or this file beside the compose file for
# the compose CLI (${...} substitution; there is no env_file). DB_PATH
# and the ports are pinned inside the container, so their values above
# only matter for a direct `./gradlew run`.
#
# Host directory that holds the database (required by compose).
FINANCE2_DATA=/volume1/docker/finance2/data

# Image to run. CI publishes ghcr.io/jeffbstewart/finance2:latest on
# every merge to main (Portainer tracks it with "re-pull image") and a
# :sha-<short> tag per commit; set that to pin a release.
#FINANCE2_IMAGE=ghcr.io/jeffbstewart/finance2:latest
# Host ports (defaults shown) and container limits.
#FINANCE2_PORT=9090
#FINANCE2_INTERNAL_PORT=9091
#FINANCE2_MEM_LIMIT=512m
#FINANCE2_PIDS_LIMIT=256
# Unprivileged uid:gid the server runs as; FINANCE2_DATA must be
# writable by it (chown it, or set these to its owner).
#FINANCE2_UID=10001
#FINANCE2_GID=10001
